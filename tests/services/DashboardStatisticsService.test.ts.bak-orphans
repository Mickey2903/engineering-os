import { describe, expect, it } from "vitest";
import { DashboardStatisticsService } from "../../src/services/DashboardStatisticsService";

describe("DashboardStatisticsService", () => {
  it("returns a perfect health score for a healthy project", () => {
    const service = new DashboardStatisticsService();

    const statistics = service.calculate({
      requirementCount: 10,
      componentCount: 5,
      verificationCount: 8,
      riskCount: 2,
      adrCount: 3,

      brokenLinks: 0,
      orphanRequirements: 0,
      duplicateRelationships: 0,
    });

    expect(statistics.healthScore).toBe(100);
  });

  it("subtracts five points per broken link", () => {
    const service = new DashboardStatisticsService();

    const statistics = service.calculate({
      requirementCount: 10,
      componentCount: 5,
      verificationCount: 8,
      riskCount: 2,
      adrCount: 3,

      brokenLinks: 2,
      orphanRequirements: 0,
      duplicateRelationships: 0,
    });

    expect(statistics.healthScore).toBe(90);
  });
});
